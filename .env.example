DATABASE_URL=postgres://user:password@localhost:5432/recall_bot
PORT=3000

SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=

DASHBOARD_SESSION_SECRET=
USER_SESSION_SECRET=
PUBLIC_BASE_URL=https://your-railway-domain.up.railway.app

BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
ENDPOINT=https://storage.railway.app

# ── Walrus Memory ───────────────────────────────────────────────
# Primary storage for Slack message blobs. Without these, messages
# stay in Postgres cache with status="pending" and cannot be verified.
# Walrus publisher: PUT {WALRUS_PUBLISHER_URL}/v1/blobs
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
# Walrus aggregator: GET {WALRUS_AGGREGATOR_URL}/v1/blobs/{blobId}
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
# Optional:
# WALRUS_EPOCHS=360
# WALRUS_PERMANENT=false
# WALRUS_DELETABLE=false
# WALRUS_SEND_OBJECT_TO=
